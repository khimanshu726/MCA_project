API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_APP_ORIGIN=http://localhost:5174
JWT_SECRET=change-this-secret
# Admin panel login. Leave ADMIN_EMAIL / ADMIN_PASSWORD blank locally and you get
# the convenience default from server/config.js. That default is committed to this
# repo, so it is a published credential — in production the server refuses to seed
# the admin account without these rather than create a login anyone can read.
ADMIN_NAME=Elite Empressions Admin
ADMIN_EMAIL=admin@elite-empressions.local
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=EliteAdmin@123
VITE_API_URL=
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
VITE_STOREFRONT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Customer login needs BOTH halves of Firebase. VITE_FIREBASE_* (above) let the
# browser sign someone in; FIREBASE_ADMIN_* let the server verify the token it
# was given. With only the first set, login looks like it works and every
# authenticated request fails 503 — saved addresses are unreachable, and orders
# are stored with no owner, so they never appear in order history.
# Verify with `auth.firebaseAdminConfigured` on GET /api/health.

# Razorpay. The browser receives the key id from the create-order response,
# so there is no VITE_ copy to keep in sync — set these two and the checkout
# works. RAZORPAY_WEBHOOK_SECRET is a different secret from KEY_SECRET (it is
# set on the webhook itself); without it payments succeed but orders never
# leave PaymentPending.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary — where uploaded files live (product photos, studio artwork,
# order design files). Optional locally: leave blank and uploads are written to
# ./uploads, which is fine on your own machine.
#
# REQUIRED in production. Render's filesystem is ephemeral, so a disk-backed
# upload is erased on the next redeploy. Rather than lose files silently, the
# server refuses uploads with a 503 when these are unset in production; check
# `uploads.durable` on GET /api/health.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production examples for Render
# CLIENT_ORIGIN=https://your-app-name.onrender.com
# ADMIN_APP_ORIGIN=https://your-app-name.onrender.com

# Where new-order notifications are emailed (sent via Resend)
ADMIN_NOTIFICATION_EMAIL=admin@elite-empressions.local

# ---------------------------------------------------------------------------
# Optional overrides — every key below has a working default in the code, so
# leave them commented out unless you need to change something.
# ---------------------------------------------------------------------------

# VITE_API_URL is intentionally blank above: the apps then use /api through the
# Vite dev proxy locally (and same-origin /api in production).

# Transactional email via Resend and the From address
# RESEND_API_KEY=
# EMAIL_FROM=Elite Impressions <orders@eliteimpressions.co.in>
# EMAIL_SECURITY_PROVIDER=resend   # or: firebase

# Store a bcrypt hash instead of a plaintext ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Public URLs used in emails and the sitemap
# STOREFRONT_URL=https://eliteimpressions.co.in
# SITE_URL=https://eliteimpressions.co.in

# Pricing (INR; TAX_RATE is a fraction)
# PLATFORM_FEE=15
# TAX_RATE=0.05
# SHIPPING_FEE=120
# FREE_SHIPPING_THRESHOLD=1000

# Footer social links
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_FACEBOOK=
# VITE_SOCIAL_TWITTER=
# VITE_SOCIAL_LINKEDIN=
# VITE_SOCIAL_YOUTUBE=

# Show "Continue with Facebook" on the storefront login. Enable Facebook under
# Firebase → Authentication → Sign-in method first, or every click will fail.
# VITE_ENABLE_FACEBOOK_LOGIN=true

# Firebase Auth emulator for local testing (better in an untracked .env.local)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
